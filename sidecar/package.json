{
  "name": "golem-sidecar",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "node dist/index.js",
    "build": "tsc -b",
    "dev": "tsx src/index.ts",
    "generate:proto": "protoc --plugin=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=src/grpc/generated --ts_proto_opt=outputServices=grpc-js --ts_proto_opt=esModuleInterop=true --ts_proto_opt=env=node --ts_proto_opt=outputJsonMethods=false -I ../proto ../proto/minecraft.proto",
    "patch:viewer": "node scripts/patch-viewer.cjs",
    "postinstall": "node scripts/patch-viewer.cjs",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cover": "vitest run --coverage"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.11.0",
    "@grpc/grpc-js": "^1.12.0",
    "canvas": "^3.2.3",
    "mineflayer": "^4.37.0",
    "mineflayer-auto-eat": "^5.0.3",
    "mineflayer-collectblock": "^1.6.0",
    "mineflayer-pathfinder": "^2.4.5",
    "mineflayer-tool": "^1.2.0",
    "playwright": "^1.49.0",
    "prismarine-viewer": "^1.30.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.5",
    "assert": "^2.1.0",
    "buffer": "^6.0.3",
    "fs-extra": "^11.3.4",
    "grpc-tools": "^1.12.4",
    "minecraft-assets": "^1.17.0",
    "prettier": "3.5.3",
    "process": "^0.11.10",
    "ts-proto": "^2.6.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.5",
    "webpack": "^5.106.2",
    "webpack-cli": "^7.0.2"
  }
}
